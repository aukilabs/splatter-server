{
  "dataset": {
    "images": "images",
    "resize_factor": 2,
    "max_width": 3840,
    "test_every": 8,
    "min_track_length": 0
  },
  "optimization": {
    "strategy": "mrnf",
    "iterations": 30000,
    "max_cap": 1000000,
    "gut": false,
    "sh_degree": 2,
    "sh_degree_interval": 1000,
    "steps_scaler": 1.0,
    "means_lr": 0.00002,
    "means_lr_end": 0.0000002,
    "shs_lr": 0.002,
    "opacity_lr": 0.012,
    "scaling_lr": 0.007,
    "scaling_lr_end": 0.005,
    "rotation_lr": 0.002,
    "lambda_dssim": 0.2,
    "opacity_reg": 0.003,
    "scale_reg": 0.01,
    "scale_decay": 0.003,
    "min_opacity": 0.02,
    "init_opacity": 0.5,
    "init_scaling": 0.1,
    "enable_eval": true,
    "enable_save_eval_images": true,
    "eval_steps": [30000],
    "save_steps": [30000],
    "refine_every": 200,
    "start_refine": 0,
    "stop_refine": 28500,
    "reset_every": 3000,
    "morton_reorder_interval": 5000,
    "fill_pacing_iter": 15000,
    "grow_until_iter": 15000,
    "grow_fraction": 0.07,
    "far_seed_dose": 2000,
    "far_scene_min_fraction": 0.0,
    "growth_ratio_rank": true,
    "growth_ratio_pow": 0.75,
    "growth_grad_threshold": 0.003,
    "use_error_map": true,
    "use_edge_map": true,
    "densify_error_map": "ssim_cs",
    "max_screen_share": 0.3,
    "oversize_split_fraction": 0.25,
    "bg_mode": "random",
    "bg_modulation": false,
    "use_exposure_correction": true,
    "use_bilateral_grid": false,
    "use_ppisp": false,
    "use_depth_loss": true,
    "depth_loss_mode": "ssi",
    "depth_loss_weight": 0.4,
    "use_normal_loss": true,
    "normal_loss_weight": 0.1,
    "normal_consistency_weight": 0.1,
    "normal_flatten_weight": 0.2,
    "normal_auto_generate": true,
    "normal_start_fraction": 0.08,
    "normal_end_fraction": 1.0,
    "normal_loss_space": "auto"
  }
}
